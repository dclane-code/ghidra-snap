# gitginore template for creating Snap packages
# website: https://snapcraft.io/

parts/
prime/
stage/
*.snap

# Snapcraft global state tracking data(automatically generated)
# https://forum.snapcraft.io/t/location-to-save-global-state/768
/snap/.snapcraft/

# Source archive packed by `snapcraft cleanbuild` before pushing to the LXD container
/*_source.tar.bz2

# image-garden(1) generated VM images/state and spread's own resume
# bookkeeping, left behind by `spread garden:...` runs from the repo root
/.image-garden/
/.spread-reuse*.yaml
/*.qcow2
/*.run
/*.seed.iso
/*.user-data
/*.meta-data
/*.lock
/*.serial.log
/*.stdout.log
/*.stderr.log
/*.qcow2.log
/efi-code.*.img
/efi-vars.*.img
